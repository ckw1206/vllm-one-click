# Copy to .env and adjust, then: docker compose up -d --build

# --- Model ---
# Any Hugging Face diffusers text-to-image repo.
MODEL_PATH=Qwen/Qwen-Image
SERVED_MODEL_NAME=Qwen-Image
# Swap to FLUX.2-dev (32B, gated -> needs a token below):
#   MODEL_PATH=black-forest-labs/FLUX.2-dev
#   SERVED_MODEL_NAME=FLUX.2-dev

# --- Generation defaults ---
NUM_INFERENCE_STEPS=50
TRUE_CFG_SCALE=4.0      # used by Qwen-Image
GUIDANCE_SCALE=4.0      # used by FLUX-style pipelines

# --- Hardware ---
GPU_ID=0               # which single GPU to use

# --- Networking ---
HOST_IP=0.0.0.0
PORT=8000

# --- Auth / access ---
# Qwen-Image is public; leave blank. Set for gated/private repos (e.g. FLUX.2-dev).
HUGGING_FACE_HUB_TOKEN=
# Require this bearer token on API requests; blank or "not-needed" = open.
API_KEY=

# --- Paths / base image ---
# Host dir for the HF cache (persists weights). Defaults to $HOME/.cache/huggingface.
# HF_CACHE=/data/hf-cache
BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
