# Optional per-run overrides for start.sh.
#
# cp .env.sample .env   (the real .env is not tracked by git).
# Precedence: shell env > ./.env > start.sh defaults.

# GPUs to use: 8 -> TP8+EP8 (default), 4 -> TP4. Other counts are rejected.
GPU_ID=0,1,2,3,4,5,6,7

# API bind address and port.
HOST=0.0.0.0
PORT=8000

# SGLang image (needs >= v0.5.4.post1 for MiniMax-M2).
IMAGE=lmsysorg/sglang:v0.5.21

# Fraction of GPU memory for weights + KV cache (guide value).
MEM_FRACTION=0.85

# minimax-append-think = <think> kept inline in content (guide default)
# minimax              = thinking split into reasoning_content
REASONING_PARSER=minimax-append-think

# Speculative decoding with nvidia/MiniMax-M2.7-DFlash (0 = off, 1 = on).
# Demo-only, non-commercial license; untested on SGLang/H200.
DFLASH=0
# DRAFT_MODEL=nvidia/MiniMax-M2.7-DFlash

# HuggingFace cache on the host (~220GB for this model).
# HF_CACHE=/data/huggingface

# Optional; MiniMax-M2.7 is public, a token only raises Hub rate limits.
# HF_TOKEN=

# Extra SGLang flags, appended last (override anything above).
# EXTRA_ARGS=--context-length 131072
